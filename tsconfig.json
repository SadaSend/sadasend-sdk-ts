{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "rootDir": ".",
    "paths": {
      "sadasend": ["./src/index.ts"],
      "sadasend/webhooks": ["./src/webhooks.ts"]
    }
  },
  "include": [
    "src",
    "examples",
    "test"
  ],
  "exclude": [
    "dist"
  ]
}
